import os
import sys
import time
import re
import datetime
import subprocess
from io import BytesIO
from PIL import Image, ImageDraw, ImageFont
from calibre.web.feeds.news import BasicNewsRecipe

# --- 1. 设置时区 ---
os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

# --- 2. 自动安装中文字体 (针对 GitHub Actions / Ubuntu 环境) ---
def ensure_chinese_font():
    font_path = "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc"
    if not os.path.exists(font_path):
        print(">>> 正在安装中文字体库...")
        # 更新源并安装 Noto CJK 字体
        subprocess.run(["sudo", "apt-get", "update"], check=True, capture_output=True)
        subprocess.run(["sudo", "apt-get", "install", "-y", "fonts-noto-cjk"], check=True, capture_output=True)
        print(">>> 字体安装完成。")
    return font_path

FONT_PATH = ensure_chinese_font()

class AdvancedUserRecipeAll(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('全球新闻合集(%Y-%m-%d_%H-%M)')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 12

    no_summaries = True
    use_embedded_content = True

    remove_tags = [
        dict(name='hr'),
        dict(name='a', attrs={'href': re.compile(r'.*feedx.*')}),
        dict(name='script'),
        dict(name='style'),
    ]

    def get_cover_url(self):
        now_dt = datetime.datetime.now()
        # 格式化为：2026-06-04 15:30:25
        date_str = now_dt.strftime('%Y-%m-%d %H:%M:%S')

        width, height = 600, 800
        img = Image.new('RGB', (width, height), color='white')
        draw = ImageDraw.Draw(img)

        try:
            # 使用刚才安装的 Noto Sans CJK 字体
            font_big = ImageFont.truetype(FONT_PATH, 60)
            font_small = ImageFont.truetype(FONT_PATH, 36)
        except Exception as e:
            print(f"字体加载失败: {e}")
            # 如果还是失败，回退到默认字体（但这会导致中文乱码，所以必须确保上面安装成功）
            font_big = ImageFont.load_default()
            font_small = ImageFont.load_default()

        # 绘制标题
        draw.text((width//2, height * 0.40), "全球新闻合集", font=font_big, fill='black', anchor='mm')

        # 绘制日期时间
        draw.text((width//2, height * 0.55), date_str, font=font_small, fill='black', anchor='mm')

        buf = BytesIO()
        img.save(buf, format='PNG')
        buf.seek(0)
        return buf

    def parse_article(self, article):
        raw_html = super().parse_article(article)
        source_name = article.feed.title if hasattr(article.feed, 'title') else ''
        author_name = article.author if hasattr(article, 'author') and article.author else ''
        pub_date = article.pubdate.strftime('%b %d') if hasattr(article, 'pubdate') else ''
        full_date = article.pubdate.strftime('%Y-%m-%dT%H:%M:%S.000Z') if hasattr(article, 'pubdate') else ''

        head_text = (
            f"{source_name}\n"
            f"{pub_date}\n\n"
            f"{author_name}\n"
            f"{full_date}\n\n"
        )
        final_html = f"<p>{head_text}</p>" + raw_html
        return final_html

    def preprocess_html(self, soup):
        for a in soup.find_all('a'):
            if 'feedx' in a.get('href', ''):
                a.decompose()
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        return soup

    feeds = [
        ('德国之声','https://feedx.net/rss/dw.xml'),
        ('BBC中文','https://feedx.net/rss/bbc.xml'),
        ('法广中文','https://feedx.net/rss/rfi.xml'),
        ('联合早报','https://feedx.net/rss/zaobao.xml'),
        ('纽约时报','https://raw.githubusercontent.com/644646497/rss/refs/heads/main/feed.xml'),
        ('数字','https://feeds.feedburner.com/chinadigitaltimes/IyPt'),
        ('观察者网','https://rss.injahow.cn/guancha'),
        ('日经新闻','https://feedx.net/rss/nikkei.xml'),
        ('科技新报','https://technews.tw/tn-rss/'),
    ]
