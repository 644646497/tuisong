import os
import time
import re
import datetime

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class AdvancedUserRecipeAll(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('日经新闻 - %Y-%m-%d %H:%M')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 20

    no_summaries = True
    use_embedded_content = True
    keep_images = True

    remove_tags = [
        dict(name='hr'),
        dict(name='a', attrs={'href': re.compile(r'.*feedx.*')}),
        dict(name='script'),
        dict(name='style'),
    ]

    def preprocess_html(self, soup):
        # 删除包含 feedx 的链接
        for a in soup.find_all('a'):
            if 'feedx' in a.get('href', ''):
                a.decompose()
        # 删除包含"获取更多RSS"的div
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        
        # === 修复日经新闻的图片相对路径 ===
        for img in soup.find_all('img'):
            src = img.get('src', '')
            if src.startswith('/images/'):
                img['src'] = 'http://cn.nikkei.com' + src
            # 如果还有别的相对路径格式，也可以在这里补充
            elif src.startswith('./'):
                img['src'] = 'http://cn.nikkei.com' + src[1:]
        # ================================
        
        return soup

    feeds = [
        ('日经新闻', 'https://feedx.net/rss/nikkei.xml'),
    ]
