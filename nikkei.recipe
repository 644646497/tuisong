import os
import time
import re
import datetime

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class AdvancedUserRecipe1281929028(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('日经新闻 - %Y-%m-%d %H-%M')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 15
    
    # 全文抓取设置
    no_summaries = False
    use_embedded_content = False
    
    # 保持样式
    keep_attributes = ['href', 'src', 'width', 'height']
    
    # 移除不需要的标签
    remove_tags = [
        dict(name='hr'),
        dict(name='script'),
        dict(name='style'),
        dict(name='nav'),
        dict(name='header'),
        dict(name='footer'),
        dict(name='aside'),
        dict(name='form'),
        dict(name='iframe'),
        dict(name='noscript'),
    ]
    
    # 移除包含特定内容的标签
    remove_tags_after = [
        dict(name='div', attrs={'class': re.compile(r'.*comment.*')}),
        dict(name='div', attrs={'class': re.compile(r'.*share.*')}),
        dict(name='div', attrs={'class': re.compile(r'.*ad.*')}),
        dict(name='div', attrs={'class': re.compile(r'.*related.*')}),
    ]
    
    # 文章内容所在的标签
    keep_only_tags = [
        dict(name='article'),
        dict(name='div', attrs={'class': re.compile(r'.*article.*')}),
        dict(name='div', attrs={'class': re.compile(r'.*content.*')}),
        dict(name='div', attrs={'class': re.compile(r'.*body.*')}),
        dict(name='main'),
    ]
    
    # 替换图片链接为完整URL（如果需要）
    def preprocess_html(self, soup):
        # 处理图片链接
        for img in soup.find_all('img'):
            if img.get('src') and img['src'].startswith('//'):
                img['src'] = 'https:' + img['src']
            elif img.get('src') and img['src'].startswith('/'):
                img['src'] = 'https://www.nikkei.com' + img['src']
        
        # 处理链接
        for a in soup.find_all('a'):
            if a.get('href') and a['href'].startswith('/'):
                a['href'] = 'https://www.nikkei.com' + a['href']
        
        # 移除feedx相关广告
        for a in soup.find_all('a'):
            if 'feedx' in a.get('href', ''):
                a.decompose()
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        
        return soup
    
    feeds = [
        ('日经新闻', 'https://feedx.net/rss/nikkei.xml'),
    ]
